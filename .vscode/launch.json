{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI (uv)",
            "type": "debugpy",
            "request": "launch",
            "module": "fastapi",
            "args": [
                "dev",
                "app/main.py"
            ],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "jinja": true,
            "subProcess": true
        }
    ]
}